# ---- Copier en .env, ne JAMAIS committer .env ----------------------------
# Profil par défaut : ÉCO (DeepSeek partout sauf code+déploiement, WhatsApp, VPS 4 Go).

# Postgres (docker-compose) — laissé tel quel, install.sh génère un mot de passe fort
POSTGRES_PASSWORD=change-me-32-chars-min
# GID du groupe docker de l'hôte : `getent group docker | cut -d: -f3`
DOCKER_GID=999

TZ=Europe/Paris
LOG_LEVEL=info

# ---- Autonomie -------------------------------------------------------------
# manual    : RIEN ne tourne sans ton ordre (WhatsApp/Jarvis/API) ou un planning que tu as ordonné.
# scheduled : les crons par défaut des missions tournent en plus.
AUTONOMY_MODE=manual

# ---- LLM (mode éco) ----------------------------------------------------------
# Missions normales (veille, concurrents, audit, chat, rapport) : DeepSeek via API OpenAI-compatible.
LLM_PROVIDER=openai_compat
OPENAI_COMPAT_BASE_URL=https://api.deepseek.com/v1
OPENAI_COMPAT_API_KEY=sk-...
MODEL_PLANNER=deepseek-reasoner
MODEL_WORKER=deepseek-chat
MODEL_CHAT=deepseek-chat
# Prix DeepSeek (USD / 1M tokens) — à revalider sur platform.deepseek.com
MODEL_PRICES=deepseek-reasoner=0.55/2.19,deepseek-chat=0.27/1.10
# Missions CRITIQUES (écrivent du code + déploient : seo_daily, iptv_comparator, repo_maintenance,
# rôles coder/publisher/deployer) : Claude Sonnet 5. Le sous-agent codeur (Claude Code) en dépend aussi.
LLM_PROVIDER_CRITICAL=anthropic
MODEL_CRITICAL=claude-sonnet-5
MODEL_CODER=claude-sonnet-5
ANTHROPIC_API_KEY=sk-ant-...

# Budgets (coupe-circuits, USD)
MISSION_BUDGET_USD=1.5
DAILY_BUDGET_USD=2.5

# ---- Recherche temps réel (obligatoire hors Claude) ---------------------------
TAVILY_API_KEY=tvly-...
SERPAPI_API_KEY=

# ---- GitHub / site -------------------------------------------------------------
# Fine-grained PAT limité au dépôt : Contents RW, Pull requests RW, Issues RW, Metadata R
GITHUB_TOKEN=github_pat_...
GITHUB_REPO=manzilionellm-dotcom/agent
GIT_AUTHOR_NAME=Manzi Junior
GIT_AUTHOR_EMAIL=bot@votre-domaine.fr
SITE_URL=https://votre-site.fr

# ---- Vercel (optionnel : suivi de déploiement après push) -----------------------
VERCEL_TOKEN=
VERCEL_PROJECT=

# ---- WhatsApp (canal principal) ---------------------------------------------------
# meta = Cloud API directe (recommandé, gratuit en réponse sous 24 h) | twilio | none
WHATSAPP_PROVIDER=meta
# Numéros autorisés à commander le bot (indicatif sans +). Le premier reçoit rapports et alertes.
WHATSAPP_ALLOWED_NUMBERS=33612345678
# Meta Cloud API (developers.facebook.com → app → WhatsApp)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=choisis-une-chaine-aleatoire
WHATSAPP_TEMPLATE_NAME=manzi_daily_report
WHATSAPP_TEMPLATE_LANG=fr
# Twilio (si WHATSAPP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# URL publique du webhook (Cloudflare Tunnel) — requis pour Twilio (signature), utile pour Meta
PUBLIC_URL=https://manzi.votre-domaine.fr
# Token du tunnel Cloudflare (docker-compose.eco.yml)
CLOUDFLARE_TUNNEL_TOKEN=

# ---- Secours / autres canaux -----------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
REPORT_TO_EMAIL=

# ---- Navigateur ---------------------------------------------------------------------
# Ton Chrome via tunnel SSH inverse (mode « Claude dans Chrome ») ; vide = Chromium du sandbox.
BROWSER_CDP_URL=http://host.docker.internal:9222
# X : cookie auth_token d'un compte secondaire (optionnel, améliore le scraping ; risque de suspension)
X_AUTH_TOKEN=

# ---- Garde-fous (ajoutés d'office ; désactivables) --------------------------------------
# Approbation WhatsApp des outils irréversibles (OUI-XXXX / NON-XXXX), délai en minutes
APPROVAL_TIMEOUT_MIN=10
# Messages entrants max par numéro et par heure
CHAT_RATE_LIMIT_PER_HOUR=60
# Timeout mural d'une mission (minutes)
MISSION_TIMEOUT_MIN=45
# Alerte une fois si Postgres ou le sandbox tombe (aucun LLM, aucune action)
HEARTBEAT_ALERTS=true
# Juge indépendant qui relit chaque compte rendu de mission contre son cahier des charges (~0,01 $)
VERIFY_MISSIONS=true
# Domaines interdits au navigateur (suffixes), ex: banque, paiement
BROWSER_DENY_DOMAINS=

# ---- API HTTP locale (Jarvis, curl) — laissé vide, install.sh génère le jeton ---------
ORCHESTRATOR_TOKEN=

# ---- Sandbox ------------------------------------------------------------------------
SANDBOX_TIMEOUT_MS=900000
