# ---- Copier en .env, ne JAMAIS committer .env ----------------------------

# Postgres (docker-compose)
POSTGRES_PASSWORD=change-me-32-chars-min
# GID du groupe docker de l'hôte : `getent group docker | cut -d: -f3`
DOCKER_GID=999

# Fuseau des crons et des rapports
TZ=Europe/Paris
LOG_LEVEL=info

# ---- LLM ------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
MODEL_PLANNER=claude-opus-5
MODEL_CODER=claude-opus-5
MODEL_WORKER=claude-sonnet-5
MISSION_BUDGET_USD=3
DAILY_BUDGET_USD=25

# ---- GitHub / site --------------------------------------------------------
# Fine-grained PAT limité au dépôt : Contents RW, Pull requests RW, Issues RW, Metadata R
GITHUB_TOKEN=github_pat_...
GITHUB_REPO=manzilionellm-dotcom/agent
GIT_AUTHOR_NAME=Manzi Junior
GIT_AUTHOR_EMAIL=bot@votre-domaine.fr
SITE_URL=https://votre-site.fr

# ---- Vercel (optionnel : suivi de déploiement après push) ------------------
VERCEL_TOKEN=
VERCEL_PROJECT=prj_...

# ---- X API v2 (optionnel : plan Basic) --------------------------------------
X_BEARER_TOKEN=

# ---- Rapport du matin -------------------------------------------------------
REPORT_TO_EMAIL=vous@votre-domaine.fr
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Sandbox ---------------------------------------------------------------
SANDBOX_TIMEOUT_MS=900000

# ---- API HTTP locale (Jarvis, curl) — généré par install.sh ---------------
ORCHESTRATOR_TOKEN=

# ---- Fournisseur LLM alternatif (DeepSeek / Kimi / Qwen / OpenRouter) ------
# LLM_PROVIDER=openai_compat
# OPENAI_COMPAT_BASE_URL=https://api.deepseek.com/v1
# OPENAI_COMPAT_API_KEY=sk-...
# MODEL_PLANNER=deepseek-reasoner
# MODEL_WORKER=deepseek-chat
# MODEL_PRICES=deepseek-reasoner=0.55/2.19,deepseek-chat=0.27/1.10

# ---- Recherche temps réel (obligatoire hors Claude, utile avec) ------------
TAVILY_API_KEY=
SERPAPI_API_KEY=
