{
  "name": "manzi-orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "migrate": "tsx src/memory/migrate.ts",
    "mission": "tsx src/cli.ts",
    "eval": "tsx src/evals/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "croner": "^10.0.1",
    "openai": "^7.20.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8",
    "tsx": "^4",
    "typescript": "^5"
  }
}
