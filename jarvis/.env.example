# Jarvis — copier en jarvis/.env
ANTHROPIC_API_KEY=sk-ant-...
JARVIS_MODEL=claude-opus-5
JARVIS_EFFORT=medium

# Voix : féminine française (Kokoro). Autres voix fr : ff_siwis uniquement ; en : af_heart, af_bella, af_nicole
JARVIS_KOKORO_LANG=f
JARVIS_KOKORO_VOICE=ff_siwis
JARVIS_KOKORO_SPEED=1.05

# Whisper : small (CPU, défaut) | medium | large-v3 (GPU)
JARVIS_WHISPER_MODEL=small
JARVIS_LANGUAGE=fr

# Comportement : conversation (défaut) | wake | always
JARVIS_NAME=Jarvis
JARVIS_WAKE_MODE=conversation
JARVIS_CONVERSATION_WINDOW_S=45
# Outils qui exigent un « oui » vocal (vide = exécution sans demander, comme demandé)
JARVIS_CONFIRM_TOOLS=

# Manzi Junior (VPS). En local via tunnel SSH : ssh -N -L 8787:127.0.0.1:8787 user@vps
ORCHESTRATOR_URL=http://127.0.0.1:8787
ORCHESTRATOR_TOKEN=

# MCP
GITHUB_TOKEN=
VERCEL_TOKEN=

# Audio (optionnel) : `jarvis --devices` pour lister
# JARVIS_INPUT_DEVICE=
# JARVIS_OUTPUT_DEVICE=
